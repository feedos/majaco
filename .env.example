# Conexión a una base Postgres (local, o la de Neon/Supabase). Ver README
# para cómo conseguir una gratis en 2 minutos.
DATABASE_URL="postgresql://usuario:password@localhost:5432/majaco"

# URL pública del sitio (usada para construir los links que se comparten)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Panel de administración
ADMIN_PASSWORD="cambiame"
ADMIN_SESSION_SECRET="cambiame-tambien-por-algo-largo-y-random"
